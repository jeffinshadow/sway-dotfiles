<?xml version="1.0" encoding="UTF-8"?>
<!-- Shadow Materia (paleta híbrida M3, PALETA-HIBRIDA.md) para GtkSourceView 5
     (GNOME Text Editor e afins). Ativado pelo gtk-settings.sh. -->
<style-scheme id="shadow-materia" name="Shadow Materia" version="1.0">
  <author>jeffinshadow</author>
  <description>Grafite + azul #5294E2, status pastéis</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <color name="bg"      value="#131314"/>
  <color name="ct"      value="#1A1A1C"/>
  <color name="ct_hi"   value="#222324"/>
  <color name="div"     value="#323235"/>
  <color name="div_hi"  value="#49494B"/>
  <color name="fg"      value="#F0EDEE"/>
  <color name="fg2"     value="#ACABAD"/>
  <color name="dim"     value="#919093"/>
  <color name="blue"    value="#5294E2"/>
  <color name="blue_lt" value="#8AB8F0"/>
  <color name="blue_ct" value="#183A61"/>
  <color name="on_blue" value="#0B0D10"/>
  <color name="purple"  value="#B98EFF"/>
  <color name="cyan"    value="#62C7E0"/>
  <color name="green"   value="#78CA9F"/>
  <color name="yellow"  value="#F2DA66"/>
  <color name="red"     value="#F28B82"/>

  <!-- Interface -->
  <style name="text"                    foreground="fg" background="bg"/>
  <style name="selection"               background="blue_ct"/>
  <style name="selection-unfocused"     background="ct_hi"/>
  <style name="cursor"                  foreground="blue_lt"/>
  <style name="current-line"            background="ct"/>
  <style name="current-line-number"     foreground="blue_lt" background="ct" bold="true"/>
  <style name="line-numbers"            foreground="div_hi" background="bg"/>
  <style name="right-margin"            foreground="div" background="ct"/>
  <style name="draw-spaces"             foreground="div"/>
  <style name="background-pattern"      background="ct"/>
  <style name="bracket-match"           foreground="blue_lt" background="div" bold="true"/>
  <style name="bracket-mismatch"        foreground="red" underline="error"/>
  <style name="search-match"            foreground="on_blue" background="yellow"/>
  <style name="snippet-focus"           background="blue_ct"/>

  <!-- Sintaxe -->
  <style name="def:comment"             foreground="dim" italic="true"/>
  <style name="def:shebang"             foreground="dim" bold="true"/>
  <style name="def:doc-comment-element" foreground="fg2" italic="true"/>
  <style name="def:constant"            foreground="purple"/>
  <style name="def:string"              foreground="green"/>
  <style name="def:special-char"        foreground="cyan"/>
  <style name="def:character"           foreground="green"/>
  <style name="def:number"              foreground="purple"/>
  <style name="def:boolean"             foreground="purple"/>
  <style name="def:floating-point"      foreground="purple"/>
  <style name="def:identifier"          foreground="fg"/>
  <style name="def:function"            foreground="blue_lt"/>
  <style name="def:statement"           foreground="blue" bold="true"/>
  <style name="def:keyword"             foreground="blue" bold="true"/>
  <style name="def:builtin"             foreground="cyan"/>
  <style name="def:operator"            foreground="fg2"/>
  <style name="def:preprocessor"        foreground="cyan"/>
  <style name="def:type"                foreground="yellow"/>
  <style name="def:special-constant"    foreground="purple"/>
  <style name="def:emphasis"            italic="true"/>
  <style name="def:strong-emphasis"     bold="true"/>
  <style name="def:heading"             foreground="blue_lt" bold="true"/>
  <style name="def:link-text"           foreground="blue_lt"/>
  <style name="def:link-destination"    foreground="dim" underline="single"/>
  <style name="def:inline-code"         foreground="cyan"/>
  <style name="def:note"                foreground="on_blue" background="yellow" bold="true"/>
  <style name="def:error"               foreground="red" underline="error"/>
  <style name="def:warning"             foreground="yellow" underline="error"/>
  <style name="def:net-address"         foreground="blue_lt" underline="single"/>
  <style name="def:underlined"          underline="single"/>

  <!-- Diff -->
  <style name="diff:added-line"         foreground="green"/>
  <style name="diff:removed-line"       foreground="red"/>
  <style name="diff:changed-line"       foreground="yellow"/>
  <style name="diff:location"           foreground="cyan"/>
  <style name="diff:diff-file"          foreground="blue_lt" bold="true"/>
</style-scheme>
