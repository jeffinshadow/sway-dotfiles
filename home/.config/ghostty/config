# ~/.config/ghostty/config — Shadow Materia
# Ghostty: GTK4, protocolo de imagens do kitty. Os ícones Nerd Font que a
# Google Sans Code não tem, o ghostty desenha sozinho.

font-family = Google Sans Code
font-size = 11
font-feature = calt
font-feature = liga

background = #131314
foreground = #F0EDEE
cursor-color = #8AB8F0
cursor-style = bar
selection-background = #183A61
selection-foreground = #F0EDEE

# Paleta híbrida M3 (PALETA-HIBRIDA.md): os pastéis ficam nos brilhantes
# (8–15); os normais (0–7) são os mesmos matizes escurecidos até ~5:1
# sobre o fundo (ainda passam AA).
palette = 0=#2C2C2D
palette = 1=#CB6860
palette = 2=#41946B
palette = 3=#998409
palette = 4=#5294E2
palette = 5=#9A6FDD
palette = 6=#2091A9
palette = 7=#F0EDEE
palette = 8=#49494B
palette = 9=#F28B82
palette = 10=#78CA9F
palette = 11=#F2DA66
palette = 12=#8AB8F0
palette = 13=#B98EFF
palette = 14=#62C7E0
palette = 15=#FFFFFF

window-padding-x = 10
window-padding-y = 8
window-decoration = none
gtk-tabs-location = bottom
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
shell-integration = zsh

# Ajustes por máquina (font-size etc.) — symlink criado pelo install.sh
config-file = ?host
