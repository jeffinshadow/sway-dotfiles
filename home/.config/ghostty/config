# ~/.config/ghostty/config — Shadow Materia
# Ghostty: GTK4, protocolo de imagens do kitty, glyphs Nerd Font nativos.

font-family = Google Sans Code NF
font-size = 11
font-feature = calt
font-feature = liga

background = #181818
foreground = #dedede
cursor-color = #8ab4f8
cursor-style = bar
selection-background = #5294e2
selection-foreground = #181818

# Mesmas cores do esquema "Shadow Materia" do Konsole
palette = 0=#282828
palette = 1=#f28b82
palette = 2=#81c995
palette = 3=#fdd663
palette = 4=#5294e2
palette = 5=#c58af9
palette = 6=#78d6e8
palette = 7=#dedede
palette = 8=#3d3d3d
palette = 9=#faaaa2
palette = 10=#a7e0bb
palette = 11=#ffe28c
palette = 12=#8ab4f8
palette = 13=#deafff
palette = 14=#9ee5f2
palette = 15=#ffffff

window-padding-x = 10
window-padding-y = 8
window-decoration = none
gtk-tabs-location = bottom
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
shell-integration = zsh

# Ajustes por máquina (font-size etc.) — symlink criado pelo install.sh
config-file = ?host
