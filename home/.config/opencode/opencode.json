{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/qwen35b",
  "providers": {
    "llama": {
      "name": "LLM local (llama.cpp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": 900000
      },
      "compatibility": {
        "maxTokensField": "max_tokens",
        "reasoningField": "reasoning_content"
      },
      "models": {
        "qwen35b": {
          "modelID": "Qwen3.6 35B pesado",
          "name": "Qwen3.6 35B (agente)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": [
            {
              "id": "pensar",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                },
                "thinking_budget_tokens": 2048
              }
            }
          ]
        },
        "qwen9b": {
          "modelID": "Qwen3.5 9B",
          "name": "Qwen3.5 9B (rápido)",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 49152,
            "output": 8192
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "variants": [
            {
              "id": "pensar",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true
                },
                "thinking_budget_tokens": 2048
              }
            }
          ]
        },
        "qwen8b": {
          "modelID": "Qwen3 8B rápido",
          "name": "Qwen3 8B (respostas curtas)",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 24576,
            "output": 4096
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "agents": {
    "plan": {
      "model": "llama/qwen35b#pensar"
    }
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "buffer": "20%",
    "keep": {
      "tokens": 8000
    },
    "background": false
  },
  "instructions": [
    ".opencode/notas.md"
  ],
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "http://127.0.0.1:3010/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/llm/mcp-token}"
        }
      }
    }
  },
