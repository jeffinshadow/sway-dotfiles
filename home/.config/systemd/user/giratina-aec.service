[Unit]
Description=Giratina: cancelamento de eco do microfone (WebRTC, referência = saída padrão)
After=pipewire.service wireplumber.service
BindsTo=pipewire.service
Before=giratina-voz.service

[Service]
ExecStart=/usr/bin/pipewire -c %h/.config/pipewire/giratina-aec.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=giratina-voz.service
