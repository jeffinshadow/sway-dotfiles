/* ~/.config/rofi/shadow-materia.rasi
   Port do materia.rasi do i3 antigo pra paleta híbrida M3
   (PALETA-HIBRIDA.md). Centralizado. */
* {
    base:      #131314;
    surface:   #1A1A1C;
    surface2:  #222324;
    outline:   #323235;
    accent:    #5294E2;
    accent-lt: #8AB8F0;
    accent-ct: #183A61;
    on-accent: #0B0D10;
    fg:        #F0EDEE;
    fg-dim:    #919093;
    red:       #F28B82;

    background-color: transparent;
    text-color:       @fg;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            560px;
    background-color: @base;
    border:           2px;
    border-color:     @outline;
    border-radius:    10px;
    padding:          12px;
}

mainbox { children: [ inputbar, message, listview ]; spacing: 10px; }

inputbar {
    children:         [ prompt, entry ];
    background-color: @surface;
    border-radius:    8px;
    padding:          10px 12px;
    spacing:          10px;
}
prompt { text-color: @accent; }
entry  { placeholder: "Buscar…"; placeholder-color: @fg-dim; cursor: text; }

message { background-color: @surface; border-radius: 8px; padding: 8px 12px; }
textbox { text-color: @fg; }

listview {
    lines:     8;
    columns:   1;
    cycle:     false;
    scrollbar: false;
    spacing:   2px;
    fixed-height: true;
}

element {
    padding:       8px 10px;
    border-radius: 6px;
    spacing:       10px;
}
element normal.normal,
element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal  { background-color: @accent-ct; text-color: @fg; }
element normal.active,
element alternate.active { text-color: @accent-lt; }
element selected.active  { background-color: @accent-ct; text-color: @accent-lt; }
element normal.urgent,
element alternate.urgent { text-color: @red; }

element-icon { size: 1.3em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
