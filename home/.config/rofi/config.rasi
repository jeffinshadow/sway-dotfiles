/* ~/.config/rofi/config.rasi */
configuration {
    modi:                "drun,run,window,ssh";
    /* SSH (Super+Shift+s): hosts do ~/.ssh/config, abre no terminal com o nome do host no título */
    ssh-command:         "{terminal} --title='ssh {host}' -e {ssh-client} {host}";
    parse-known-hosts:   false;
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    font:                "Google Sans 11";
    terminal:            "ghostty";
    drun-display-format: "{name}";
    display-drun:        "󰀻";
    display-run:         "";
    display-window:      "󰖯";
    disable-history:     false;
    sort:                true;
    sorting-method:      "fzf";
    matching:            "fuzzy";
}
@theme "shadow-materia"
