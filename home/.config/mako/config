# ~/.config/mako/config — Shadow Materia
font=Google Sans 10
background-color=#282828
text-color=#dedede
border-color=#333333
progress-color=over #5294e2
border-size=1
border-radius=8
padding=12
margin=10
width=360
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark
default-timeout=6000
anchor=top-right
layer=overlay

[urgency=low]
border-color=#333333
text-color=#999999

[urgency=critical]
border-color=#f28b82
default-timeout=0

[mode=do-not-disturb]
invisible=1
