# ~/.config/mako/config — Shadow Materia
font=Google Sans 10
background-color=#2C2C2D
text-color=#F0EDEE
border-color=#323235
progress-color=source #183A61
border-size=1
border-radius=8
padding=12
margin=10
width=360
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark
default-timeout=6000
anchor=top-right
layer=overlay

[urgency=low]
border-color=#323235
text-color=#919093

[urgency=critical]
border-color=#F28B82
default-timeout=0

[mode=do-not-disturb]
invisible=1
