# ~/.config/mako/config — Shadow Materia
# Pra ser notada: fundo azulado ("contêiner de destaque", destaca do
# grafite das janelas), borda azul de 2px, título maior e em negrito.
font=Google Sans 11
format=<b><span size="larger">%s</span></b>\n%b
background-color=#262F3C
text-color=#F0EDEE
border-color=#5294E2
progress-color=source #183A61
border-size=2
border-radius=10
padding=14,16
margin=10
width=400
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark
default-timeout=8000
anchor=top-right
layer=overlay

# Baixa prioridade: discreta como antes
[urgency=low]
background-color=#222324
border-color=#49494B
text-color=#ACABAD

# Crítica: borda vermelha mais grossa e fica até dispensar (Super+.)
[urgency=critical]
border-color=#F28B82
border-size=3
default-timeout=0

[mode=do-not-disturb]
invisible=1
