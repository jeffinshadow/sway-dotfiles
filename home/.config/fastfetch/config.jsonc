// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Dragão da shadowtec em blocos (tools/shadowtec-ascii.sh). logo.txt é
  // link pro tamanho da máquina (hosts/<host>/fastfetch-logo.txt). As
  // linhas vão de $1 a $9 de cima pra baixo: cores iguais = cor única.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;240;237;238", "2": "38;2;240;237;238", "3": "38;2;240;237;238",
      "4": "38;2;240;237;238", "5": "38;2;240;237;238", "6": "38;2;240;237;238",
      "7": "38;2;240;237;238", "8": "38;2;240;237;238", "9": "38;2;240;237;238"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "white" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#1}\udbc0\udc00  {host-name}" },   // dragão (U+100000, ShadowTec Symbols)
    { "type": "custom", "format": "\u001b[38;2;73;73;75m────────────────────────────────\u001b[0m" },
    "break",
    { "type": "custom", "format": "\u001b[1m󰇺  Hardware\u001b[0m" },
    "break",
    { "type": "board", "key": "󰌢", "format": "{2} {1} ({3})" },
    { "type": "cpu",     "key": "󰻠" },
    { "type": "gpu",     "key": "󰢮" },
    { "type": "memory",  "key": "󰑭" },
    { "type": "disk",    "key": "󰋊" },
    { "type": "display", "key": "󰍹" },
    "break",
    { "type": "custom", "format": "\u001b[38;2;73;73;75m────────────────────────────────\u001b[0m" },
    "break",
    { "type": "custom", "format": "\u001b[1m󰆍  Software\u001b[0m" },
    "break",
    { "type": "kernel",       "key": "󰌽" },
    { "type": "os",           "key": "󰣇" },
    { "type": "wm",           "key": "󱂬" },   // sway é WM; o módulo "de" fica vazio
    { "type": "command", "key": "󰏘", "text": "echo shadow-materia" },
    { "type": "icons",        "key": "󰀻" },
    { "type": "terminalfont", "key": "󰛖" },
    { "type": "packages",     "key": "󰏖" },
    { "type": "media", "key": "󰝚", "format": "{1} - {3}" },
    "break",
    "colors"
  ]
}
