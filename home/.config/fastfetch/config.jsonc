// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Dragão da shadowtec em imagem (protocolo de imagens do kitty, que o
  // ghostty suporta): o terminal lê o PNG direto, sem ImageMagick/chafa.
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/shadowtec.png",
    "width": 44,
    "height": 22,
    "padding": { "top": 1, "left": 1, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "white" }
  },
  "modules": [
    // 2 linhas vazias em cima: texto centralizado na imagem. O tamanho da
    // imagem por máquina vem de hosts/<host>/fastfetch.args (ver .zshrc)
    "break",
    "break",
    { "type": "title", "format": "{#1}\udbc0\udc00  {host-name}" },   // dragão (U+100000, ShadowTec Symbols)
    { "type": "custom", "format": "\u001b[38;2;73;73;75m────────────────────────────────\u001b[0m" },
    { "type": "custom", "format": "\u001b[1m󰇺  Hardware\u001b[0m" },
    { "type": "board", "key": "󰌢", "format": "{2} {1} ({3})" },
    { "type": "cpu",     "key": "󰻠" },
    { "type": "gpu",     "key": "󰢮" },
    { "type": "memory",  "key": "󰑭" },
    { "type": "disk",    "key": "󰋊" },
    { "type": "display", "key": "󰍹" },
    { "type": "custom", "format": "\u001b[38;2;73;73;75m────────────────────────────────\u001b[0m" },
    { "type": "custom", "format": "\u001b[1m󰆍  Software\u001b[0m" },
    { "type": "kernel",       "key": "󰌽" },
    { "type": "os",           "key": "󰣇" },
    { "type": "wm",           "key": "󱂬" },   // sway é WM; o módulo "de" fica vazio
    { "type": "terminalfont", "key": "󰛖" },
    { "type": "packages",     "key": "󰏖" },
    { "type": "media", "key": "󰝚", "format": "{1:-38}{?3} - {3:-16}{?}" },   // corta com … (título longo do YouTube)
    "break",
    "colors",
    "break"
  ]
}
