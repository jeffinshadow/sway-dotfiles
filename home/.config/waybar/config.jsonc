// ~/.config/waybar/config.jsonc — Shadow Materia
// Uma barra por monitor; os módulos ficam em modules.jsonc. O que está
// aqui vale por cima do arquivo incluído.
[
  {
    // Todos os monitores, menos o LG 24"
    "output": "!LG Electronics LG FHD 0x00072E48",
    "include": ["~/.config/waybar/modules.jsonc"]
  },
  {
    // LG 24" (giratina, e a latios pelo KVM): a webcam fica presa no meio
    // da borda de cima e tampava o grupo "sistema" aberto. Aqui ele não
    // abre: o resumo de CPU/memória/GPU/disco fica no tooltip da pílula.
    "output": "LG Electronics LG FHD 0x00072E48",
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-right": ["idle_inhibitor", "gamemode", "pulseaudio", "backlight",
                      "custom/sistema", "custom/docker", "custom/vpn", "custom/tunnel",
                      "battery", "tray", "clock", "custom/dnd", "custom/power"]
  }
]
