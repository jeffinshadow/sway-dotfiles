// ~/.config/waybar/config.jsonc — Shadow Materia
// Módulos sem hardware correspondente (bateria/brilho no desktop) somem sozinhos.
// Os custom/* (scripts/) também: sem GPU AMD, docker, disco de jogos ou
// túnel o script não imprime nada e o módulo não aparece.
{
  "layer": "top",
  "position": "top",
  "spacing": 8,
  "margin-top": 10,      // = gaps inner do sway
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["custom/arch", "sway/workspaces", "sway/mode", "sway/scratchpad", "custom/rec"],
  "modules-center": ["clock"],
  "modules-right":  ["idle_inhibitor", "gamemode", "pulseaudio", "backlight",
                     "cpu", "memory", "temperature", "custom/gpu",
                     "disk", "custom/jogos", "custom/docker", "custom/tunnel",
                     "battery", "tray", "custom/dnd", "custom/power"],

  "custom/arch": {
    // Logo da shadowtec (shadowtec.svg) + nome da máquina sem o "shadowtec-": com o KVM as duas telas
    // são quase iguais, isso diz em qual se está.
    "exec": "cut -d- -f2- /etc/hostname",
    "interval": "once",
    "format": "<span size='smaller' weight='bold'>{}</span>",   // logo: style.css
    "tooltip-format": "Apps\nBotão direito: atalhos (Super+F1)",
    "on-click": "pkill -x rofi || rofi -show drun",
    "on-click-right": "~/.config/sway/scripts/keybinds.sh"
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    // Número + ícone de cada janela aberta (app_id no Wayland, class no X)
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "󰖯",
    "window-rewrite": {
      "class<firefox>": "󰈹",
      "class<chromium|google-chrome>": "󰊯",
      "class<com.mitchellh.ghostty|foot|kitty>": "󰆍",
      "class<org.gnome.Nautilus>": "󰉋",
      "class<org.telegram.desktop>": "",
      "class<vesktop|discord>": "󰙯",
      "class<steam>": "󰓓",
      "class<steam_app_.*|gamescope>": "󰊓",
      "class<gimp.*>": "",
      "class<org.inkscape.Inkscape>": "",
      "class<vlc>": "󰕼",
      "class<code|code-oss|codium>": "󰨞",
      "class<pavucontrol|org.pulseaudio.pavucontrol>": "󰕾",
      "class<org.gnome.Papers|org.gnome.Evince>": "󰈦",
      "class<org.gnome.Loupe>": "󰋩",
      "class<org.gnome.Calculator>": "󰃬",
      "class<org.gnome.TextEditor>": "󰧭",
      "class<io.missioncenter.MissionCenter|io.github.ilya_zlobintsev.LACT>": "󰄪",
      "class<anydesk>": "󰢹"
    }
  },

  "sway/mode": { "format": "󰩨 {}" },

  "sway/scratchpad": {
    "format": "󰖲 {count}",
    "show-empty": false,
    "tooltip-format": "{app}: {title}"
  },

  "clock": {
    "format": "{:L%a %d/%m  %H:%M}",   // L = usa o "locale" (dia em português)
    "locale": "pt_BR.UTF-8",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months":   "<span color='#8AB8F0'><b>{}</b></span>",
        "weekdays": "<span color='#919093'>{}</span>",
        "today":    "<span color='#5294E2'><b><u>{}</u></b></span>"
      }
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Tela não apaga",
    "tooltip-format-deactivated": "Bloqueio automático ativo"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mudo",
    "format-bluetooth": "󰂰 {volume}%",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle",
    "scroll-step": 5
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "swayosd-client --brightness raise",
    "on-scroll-down": "swayosd-client --brightness lower"
  },

  "cpu":    { "format": "󰻠 {usage}%", "interval": 3, "on-click": "ghostty -e btop" },
  "memory": { "format": "󰍛 {percentage}%", "interval": 5, "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },

  "temperature": {
    // Pacote da CPU (coretemp, Intel). hwmon-path-abs não depende da
    // numeração hwmonN, que muda entre boots. thermal_zone0 no Dell é um
    // sensor ACPI do chassi (fica ~25° parado).
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏 {temperatureC}°",
    "format-critical": "󰸁 {temperatureC}°"
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "lact gui"
  },

  "disk": {
    "path": "/",
    "format": "󰋊 {percentage_used}%",
    "interval": 60,
    "states": { "warning": 85, "critical": 95 },
    "tooltip-format": "Sistema (/)\n{used} usados de {total} · {free} livres",
    "on-click": "ghostty -e ncdu -x /"
  },

  "custom/jogos": {
    "exec": "~/.config/waybar/scripts/jogos.sh",
    "return-type": "json",
    "interval": 60
  },

  "custom/docker": {
    "exec": "~/.config/waybar/scripts/docker.sh",
    "return-type": "json",
    "interval": 10,
    "on-click": "ghostty -e docker stats"
  },

  "custom/tunnel": {
    "exec": "~/.config/waybar/scripts/tunnel.sh",
    "return-type": "json",
    "interval": 15
  },

  "gamemode": {
    "format": "{glyph}",
    "glyph": "󰓅",
    "use-icon": false,
    "hide-not-running": true,
    "tooltip-format": "Gamemode ativo ({count} jogo(s))"
  },

  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "{timeTo}\n{power:.1f} W"
  },

  "tray": { "icon-size": 20, "spacing": 10 },

  "custom/rec": {
    // Só aparece gravando (sway/scripts/record.sh, Super+Print)
    "exec": "~/.config/waybar/scripts/rec.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 9,
    "on-click": "~/.config/sway/scripts/record.sh"
  },

  "custom/dnd": {
    // Não perturbe do mako (Super+Shift+n)
    "exec": "~/.config/waybar/scripts/dnd.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-click": "~/.config/sway/scripts/dnd.sh",
    "on-click-right": "makoctl restore"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/powermenu.sh"
  }
}
