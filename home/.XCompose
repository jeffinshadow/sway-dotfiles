# ~/.XCompose — teclas mortas do ABNT2 no estilo Windows
# Gerado a partir das tabelas do sistema (pt_BR.UTF-8 + en_US.UTF-8).
#
# Acento + tecla que NÃO forma letra acentuada → sai o acento e a tecla
# (ex.: ~ /  →  "~/"), em vez de o GTK inventar uma letra com acento
# combinado (d̃) ou ficar esperando. Letras acentuadas (ã é ê à ü ç...)
# continuam vindo da tabela do sistema, incluída abaixo.
# Pontuação e números sempre saem literais (^1 = "^1", não "¹").

include "%L"

# dead_tilde
<dead_tilde> <exclam> : "~!"
<dead_tilde> <quotedbl> : "~\""
<dead_tilde> <numbersign> : "~#"
<dead_tilde> <dollar> : "~$"
<dead_tilde> <percent> : "~%"
<dead_tilde> <ampersand> : "~&"
<dead_tilde> <apostrophe> : "~'"
<dead_tilde> <parenleft> : "~("
<dead_tilde> <parenright> : "~)"
<dead_tilde> <asterisk> : "~*"
<dead_tilde> <plus> : "~+"
<dead_tilde> <comma> : "~,"
<dead_tilde> <minus> : "~-"
<dead_tilde> <period> : "~."
<dead_tilde> <slash> : "~/"
<dead_tilde> <colon> : "~:"
<dead_tilde> <semicolon> : "~;"
<dead_tilde> <less> : "~<"
<dead_tilde> <equal> : "~="
<dead_tilde> <greater> : "~>"
<dead_tilde> <question> : "~?"
<dead_tilde> <at> : "~@"
<dead_tilde> <bracketleft> : "~["
<dead_tilde> <backslash> : "~\\"
<dead_tilde> <bracketright> : "~]"
<dead_tilde> <underscore> : "~_"
<dead_tilde> <braceleft> : "~{"
<dead_tilde> <bar> : "~|"
<dead_tilde> <braceright> : "~}"
<dead_tilde> <0> : "~0"
<dead_tilde> <1> : "~1"
<dead_tilde> <2> : "~2"
<dead_tilde> <3> : "~3"
<dead_tilde> <4> : "~4"
