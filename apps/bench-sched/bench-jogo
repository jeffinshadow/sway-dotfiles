#!/usr/bin/env bash
# bench-jogo %command% — wrapper da opção de inicialização do Steam. Se houver uma rodada
# armada (bench-sched.sh jogo ...), liga o log do MangoHud por quadro, sem overlay, na pasta
# da rodada (Shift+F2 começa; para sozinho em 65 s). Sem rodada: só executa o jogo.
r="${XDG_RUNTIME_DIR:-/tmp}/bench-sched-rodada"
if [[ -f "$r" ]]; then
    export MANGOHUD=1
    export MANGOHUD_CONFIG="no_display,log_interval=0,log_duration=65,toggle_logging=Shift_L+F2,output_folder=$(cat "$r")"
fi
exec "$@"
