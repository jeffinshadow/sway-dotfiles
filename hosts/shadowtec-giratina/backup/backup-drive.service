[Unit]
Description=Backup da giratina no Google Drive (restic)
StartLimitIntervalSec=4h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'command -v nm-online >/dev/null 2>&1 && nm-online -q -t 90 || true'
ExecStart=%h/.local/bin/backup-drive
Nice=10
IOSchedulingClass=idle
Restart=on-failure
RestartSec=15min
StandardOutput=append:%h/backups/backup-drive.log
StandardError=append:%h/backups/backup-drive.log
